# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
web/.next/
web/out/
web/build/
web/next-env.d.ts

# SQLite transient journal files. carvaan.db itself IS tracked: rebuilding it
# means re-running hours of network resolution, so it is the expensive artifact
# worth keeping, while these two are per-process scratch.
*.db-wal
*.db-shm

# Intermediate scratch from the PDF parse (regenerated by pdftotext)
*.xml
scratchpad/

# Environment / secrets
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python bytecode
__pycache__/
*.pyc
