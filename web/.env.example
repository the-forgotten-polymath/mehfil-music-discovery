# Copy to .env.local for local development. .env.local is gitignored; this file
# is not, so never put a real value here.

# Where song reports are written. An Apps Script web app deployed from
# docs/feedback-apps-script.gs — see docs/feedback-sheet.md for the setup.
#
# Server-only, deliberately: no NEXT_PUBLIC_ prefix. The script has to be
# callable by "Anyone" for our server to reach it without a Google identity,
# which means anyone holding the URL can append rows. Behind /api/feedback the
# only way in is through that route's checks.
#
# Unset, /api/feedback answers 503 and logs the report rather than accepting it
# and dropping it, so nothing is lost while this is being configured.
FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Origin used for og:image and canonical URLs. Optional on Vercel, which
# supplies VERCEL_PROJECT_PRODUCTION_URL; set it only to override that.
# NEXT_PUBLIC_SITE_URL=https://mehfil.shashwa7.in
